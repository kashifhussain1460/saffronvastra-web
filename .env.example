# Copy to .env.local for local work. On Vercel set these under Project Settings > Environment Variables.
# Nothing here is secret: the storefront holds no payment or database keys.

# Address of the backend API (no trailing slash). The site forwards /api/v1/*, /uploads/* and /health/* to it,
# and its server-rendered pages read catalogue and settings from it.
# Production example: https://api.saffronvastra.com
API_ORIGIN=http://127.0.0.1:4000

# Public address of this website (no trailing slash). Used for canonical links, the sitemap and social previews.
# Production example: https://www.saffronvastra.com
SITE_URL=http://localhost:3000

# Fallback for SITE_URL when that is not set. Usually leave empty.
NEXT_PUBLIC_SITE_URL=

# Let search engines index the site. Leave empty (or false) everywhere except the live production site.
ALLOW_INDEXING=

# Meta (Facebook) Pixel ID (digits only; it is public, not a secret). Set it ONLY on the live production site,
# so staging, previews and local work don't send test traffic to Meta. Leave empty to disable the pixel.
META_PIXEL_ID=

# Largest image (in MB) the admin and request-photo screens accept. Leave empty on a normal server (15).
# On Vercel set 4: a function request body is limited to 4.5 MB. The API enforces the same limit.
NEXT_PUBLIC_MAX_UPLOAD_MB=

# --- SEO / analytics (production only; leave empty on staging and previews) ---
# Google tag of the GA4 web data stream (shown in GA4 > Admin > Data streams > the stream > View tag instructions).
# Loaded once, only when ALLOW_INDEXING=true and only on the live hostname. Live: GTM-57249T4S
GOOGLE_TAG_ID=
# GA4 Measurement ID of that stream, for reference and documentation; the Google tag above already sends to it, so
# it is NOT loaded as a second tag. Live: G-GEMZJ953KR
GA_MEASUREMENT_ID=
# Search Console HTML-tag token (only the content="…" value). Leave empty: the domain is verified by DNS TXT.
GOOGLE_SITE_VERIFICATION=
# Brand profiles for structured data (Organization sameAs), comma-separated: Etsy shop, Instagram, Pinterest…
BRAND_SAME_AS=
