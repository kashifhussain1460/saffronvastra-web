# Copy to .env.local for local work. On Vercel set these under Project Settings > Environment Variables.
# Nothing here is secret: the storefront holds no payment or database keys.

# Address of the backend API (no trailing slash). The site forwards /api/v1/*, /uploads/* and /health/* to it,
# and its server-rendered pages read catalogue and settings from it.
# Production example: https://api.saffronvastra.com
API_ORIGIN=http://127.0.0.1:4000

# Public address of this website (no trailing slash). Used for canonical links, the sitemap and social previews.
# Production example: https://www.saffronvastra.com
SITE_URL=http://localhost:3000

# Fallback for SITE_URL when that is not set. Usually leave empty.
NEXT_PUBLIC_SITE_URL=

# Let search engines index the site. Leave empty (or false) everywhere except the live production site.
ALLOW_INDEXING=

# Largest image (in MB) the admin and request-photo screens accept. Leave empty on a normal server (15).
# On Vercel set 4: a function request body is limited to 4.5 MB. The API enforces the same limit.
NEXT_PUBLIC_MAX_UPLOAD_MB=
